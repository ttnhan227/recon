# ==========================================================
# Recon QA Agent - Environment Configuration (.env)
# ==========================================================
# Recon is 100% BYOK (Bring Your Own Key) or run offline (mock/ollama).

# Choose your provider:
# 'gemini' | 'mistral' | 'openai' | 'anthropic' | 'deepseek' | 'groq' | 'ollama' | 'openrouter' | 'mock'
RECON_LLM_PROVIDER=gemini

# 1. Google Gemini (Recommended - Free Tier & Fast)
GEMINI_API_KEY=your_gemini_api_key_here
RECON_GEMINI_MODEL=gemini-2.5-flash

# 2. Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here
RECON_MISTRAL_MODEL=mistral-small-latest

# 3. OpenAI
OPENAI_API_KEY=your_openai_api_key_here
RECON_OPENAI_MODEL=gpt-4o-mini

# 4. Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
RECON_ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# 5. Local / Custom / Any OpenAI-Compatible Provider (Ollama, Groq, DeepSeek, OpenRouter)
# RECON_LLM_PROVIDER=ollama
# RECON_LLM_BASE_URL=http://localhost:11434/v1
# RECON_LLM_MODEL=llama3.2

