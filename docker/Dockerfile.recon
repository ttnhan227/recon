FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    RECON_REPORTS_DIR=/app/reports

WORKDIR /app

# Install system dependencies for Playwright Chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2t64 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user and directories
RUN groupadd -r recon && useradd -r -g recon -u 1000 -d /app -s /bin/bash reconuser \
    && mkdir -p /app/reports /ms-playwright \
    && chown -R reconuser:recon /app /ms-playwright

# Pre-install Playwright and browser binaries for fast layer caching
RUN pip install --no-cache-dir "playwright>=1.44.0" \
    && python -m playwright install --with-deps chromium

# Copy package metadata and source before installing the project.  The source
# must be present when setuptools builds the wheel; copying it afterwards
# leaves the `recon` console script pointing at a package that was never
# installed.
COPY pyproject.toml README.md ./
COPY recon/ ./recon/

# Install project dependencies and the Recon package itself.
RUN pip install --no-cache-dir .[browser]

# Finalize ownership for non-root user
RUN chown -R reconuser:recon /app

USER reconuser

ENTRYPOINT ["recon"]
CMD ["--help"]
